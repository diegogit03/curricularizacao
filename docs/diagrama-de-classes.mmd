classDiagram
    direction TB

    class User {
        <<Model>>
        +string name
        +string email
        +string password
        +datetime email_verified_at
        +canAccessPanel(Panel panel) bool
    }

    class Category {
        <<Model>>
        +string name
        +TransactionType type
        +transactions() HasMany
        +accounts() HasMany
    }

    class Transaction {
        <<Model>>
        +string description
        +TransactionType type
        +decimal value
        +date date
        +category() BelongsTo
        +bankAccount() BelongsTo
    }

    class Account {
        <<Model>>
        +string description
        +TransactionType type
        +AccountStatus status
        +decimal value
        +date due_at
        +date settled_at
        +category() BelongsTo
        +bankAccount() BelongsTo
        +isSettled() bool
        +markAsSettled(date settledAt) void
        +pastDue() Builder
    }

    class BankAccount {
        <<Model>>
        +string name
        +string bank
        +string agency
        +string account_number
        +decimal initial_balance
        +transactions() HasMany
        +accounts() HasMany
    }

    class TransactionType {
        <<enum>>
        REVENUE
        EXPENSE
    }

    class AccountStatus {
        <<enum>>
        PENDING
        SETTLED
        OVERDUE
    }

    class MarkOverdueAccounts {
        <<Command>>
        +handle() int
    }

    User --> Transaction : usa/histórico
    Transaction "*" --> "1" Category : pertence a
    Category "1" --> "*" Transaction : possui
    Transaction "*" --> "0..1" BankAccount : movimenta
    Account "*" --> "1" Category : pertence a
    Account "*" --> "0..1" BankAccount : vinculada a
    Category "1" --> "*" Account : possui
    MarkOverdueAccounts ..> Account : marca vencidas
    Account --> TransactionType
    Account --> AccountStatus
    Transaction --> TransactionType
    Category --> TransactionType